# SystemUI Justfile for building and deploying

# Default device configuration
DEVICE_ID := env_var_or_default("ANDROID_SERIAL", "34231FDH2008ZM")
DEFAULT_DEVICE := "komodo"
DEFAULT_BUILD_TYPE := "userdebug"

# Deploy SystemUI to device (build, push, reboot)
deploy DEVICE=DEFAULT_DEVICE BUILD_TYPE=DEFAULT_BUILD_TYPE:
    #!/usr/bin/env bash

    # Setup build environment
    echo "Setting up build environment for {{DEVICE}}-{{BUILD_TYPE}}..."
    cd ../../../.. # Go to AOSP root
    source build/envsetup.sh
    export RELEASE_GOOGLE_{{DEVICE}}_RADIO_DIR=vendor/google_devices/{{DEVICE}}/proprietary
    lunch aosp_{{DEVICE}}-bp1a-{{BUILD_TYPE}}

    set -euo pipefail

    # Build SystemUI
    echo "Building SystemUI..."
    m SystemUI

    # Push SystemUI to device
    echo "Pushing SystemUI to device {{DEVICE_ID}}..."
    adb -s {{DEVICE_ID}} root
    adb -s {{DEVICE_ID}} remount
    adb -s {{DEVICE_ID}} push "${ANDROID_PRODUCT_OUT}/system_ext/priv-app/SystemUI/SystemUI.apk" /system_ext/priv-app/SystemUI/

    # Restart SystemUI (soft restart, no full reboot needed)
    echo "Restarting SystemUI..."
    adb -s {{DEVICE_ID}} shell "pkill -f com.android.systemui || true"

    echo "SystemUI deployed successfully!"

# Full deploy with reboot (more thorough but slower)
deploy-reboot DEVICE=DEFAULT_DEVICE BUILD_TYPE=DEFAULT_BUILD_TYPE:
    #!/usr/bin/env bash

    # Setup build environment
    echo "Setting up build environment for {{DEVICE}}-{{BUILD_TYPE}}..."
    cd ../../../.. # Go to AOSP root
    source build/envsetup.sh
    export RELEASE_GOOGLE_{{DEVICE}}_RADIO_DIR=vendor/google_devices/{{DEVICE}}/proprietary
    lunch aosp_{{DEVICE}}-bp1a-{{BUILD_TYPE}}

    set -euo pipefail

    # Build SystemUI
    echo "Building SystemUI..."
    m SystemUI

    # Push SystemUI to device
    echo "Pushing SystemUI to device {{DEVICE_ID}}..."
    adb -s {{DEVICE_ID}} root
    adb -s {{DEVICE_ID}} remount
    adb -s {{DEVICE_ID}} push "${ANDROID_PRODUCT_OUT}/system_ext/priv-app/SystemUI/SystemUI.apk" /system_ext/priv-app/SystemUI/

    # Full reboot
    echo "Rebooting device..."
    adb -s {{DEVICE_ID}} reboot

    echo "SystemUI deployed with full reboot!"

# Just build SystemUI without deploying
build DEVICE=DEFAULT_DEVICE BUILD_TYPE=DEFAULT_BUILD_TYPE:
    #!/usr/bin/env bash
    cd ../../../.. # Go to AOSP root
    source build/envsetup.sh
    export RELEASE_GOOGLE_{{DEVICE}}_RADIO_DIR=vendor/google_devices/{{DEVICE}}/proprietary
    lunch aosp_{{DEVICE}}-bp1a-{{BUILD_TYPE}}

    set -euo pipefail

    m SystemUI

    echo "SystemUI built successfully!"

# Push already-built SystemUI to device
push:
    #!/usr/bin/env bash
    set -euo pipefail

    echo "Pushing SystemUI to device {{DEVICE_ID}}..."
    adb -s {{DEVICE_ID}} root
    adb -s {{DEVICE_ID}} remount

    # Find the APK in the out directory
    APK_PATH=$(find ../../../../out -name "SystemUI.apk" -path "*/system_ext/priv-app/SystemUI/*" | head -1)
    if [ -z "$APK_PATH" ]; then
        echo "Error: SystemUI.apk not found. Did you build it first?"
        exit 1
    fi

    adb -s {{DEVICE_ID}} push "$APK_PATH" /system_ext/priv-app/SystemUI/
    echo "SystemUI pushed successfully!"

# Restart SystemUI without pushing (useful for testing)
restart:
    #!/usr/bin/env bash
    set -euo pipefail

    echo "Restarting SystemUI on device {{DEVICE_ID}}..."
    adb -s {{DEVICE_ID}} shell "pkill -f com.android.systemui || true"
    echo "SystemUI restarted!"

# Check SystemUI logs
logs:
    adb -s {{DEVICE_ID}} logcat -v time | grep -E "(SystemUI|DailyOutlook|Switchboard)"

# Clear SystemUI logs and start fresh
logs-clear:
    adb -s {{DEVICE_ID}} logcat -c
    @echo "Logs cleared. Now monitoring SystemUI..."
    @just logs

# Check if device is connected
check-device:
    #!/usr/bin/env bash
    if adb -s {{DEVICE_ID}} get-state &>/dev/null; then
        echo "Device {{DEVICE_ID}} is connected"
        adb -s {{DEVICE_ID}} shell getprop ro.product.model
    else
        echo "Device {{DEVICE_ID}} is not connected"
        echo "Available devices:"
        adb devices
        exit 1
    fi

# Quick incremental build and deploy (faster for development)
quick DEVICE=DEFAULT_DEVICE BUILD_TYPE=DEFAULT_BUILD_TYPE:
    #!/usr/bin/env bash

    cd ../../../.. # Go to AOSP root
    source build/envsetup.sh
    export RELEASE_GOOGLE_{{DEVICE}}_RADIO_DIR=vendor/google_devices/{{DEVICE}}/proprietary
    lunch aosp_{{DEVICE}}-bp1a-{{BUILD_TYPE}}

    set -euo pipefail

    # Incremental build
    echo "Building SystemUI (incremental)..."
    mmm frameworks/base/packages/SystemUI

    # Push and restart
    echo "Deploying to device..."
    adb -s {{DEVICE_ID}} root
    adb -s {{DEVICE_ID}} remount
    adb -s {{DEVICE_ID}} push "${ANDROID_PRODUCT_OUT}/system_ext/priv-app/SystemUI/SystemUI.apk" /system_ext/priv-app/SystemUI/
    adb -s {{DEVICE_ID}} shell "pkill -f com.android.systemui || true"

    echo "Quick deploy completed!"

# Help command
help:
    @echo "SystemUI Justfile Commands:"
    @echo ""
    @echo "  deploy [DEVICE] [BUILD_TYPE]  - Build, push, and soft-restart SystemUI"
    @echo "  deploy-reboot [DEVICE] [BUILD_TYPE] - Build, push, and full reboot"
    @echo "  build [DEVICE] [BUILD_TYPE]    - Just build SystemUI"
    @echo "  push                           - Push already-built SystemUI to device"
    @echo "  restart                        - Restart SystemUI process"
    @echo "  quick [DEVICE] [BUILD_TYPE]    - Quick incremental build and deploy"
    @echo "  logs                           - Monitor SystemUI logs"
    @echo "  logs-clear                     - Clear logs and start monitoring"
    @echo "  check-device                   - Check if device is connected"
    @echo "  help                           - Show this help message"
    @echo ""
    @echo "Environment Variables:"
    @echo "  ANDROID_SERIAL - Device ID (default: 34231FDH2008ZM)"
    @echo ""
    @echo "Examples:"
    @echo "  just deploy                    - Deploy to default device"
    @echo "  just deploy felix userdebug    - Deploy to felix device"
    @echo "  just quick                     - Quick incremental deploy"
