<!--
  Wafer reskin (Phase 04): the footer edit pill picks up the glass button
  fill so it reads as the same surface family as the QS tile glass cards
  above it. The ripple uses brand teal for press feedback.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
       android:inset="@dimen/qs_footer_action_inset">
    <ripple
        android:color="@*android:color/wafer_teal">
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white"/>
                <corners android:radius="@*android:dimen/wafer_corner_pill"/>
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@*android:color/wafer_glass_button_bg"/>
                <stroke
                    android:width="@*android:dimen/wafer_glass_border_width"
                    android:color="@*android:color/wafer_glass_border"/>
                <corners android:radius="@*android:dimen/wafer_corner_pill"/>
            </shape>
        </item>
    </ripple>
</inset>