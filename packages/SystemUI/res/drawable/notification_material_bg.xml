<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:androidprv="http://schemas.android.com/apk/prv/res/android"
        android:color="?android:attr/colorControlHighlight">
    <!-- Wafer reskin: layer 0 is transparent. NotificationBackgroundView paints
         the wafer glass surface (base tint, top highlight gradient, hairline
         border, drop shadow) directly in onDraw. This layer is kept so existing
         code paths (getBaseBackgroundLayer, updateBackgroundRadii, expand-anim
         AA toggling) still find a GradientDrawable at index 0. -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/notification_state_color_default" />
        </shape>
    </item>
    <item android:id="@+id/notification_focus_overlay">
        <shape>
            <stroke android:width="@dimen/notification_focus_stroke_width"
                android:color="@color/notification_focus_overlay_color"/>
        </shape>
    </item>
</layer-list>