<?xml version="1.0" encoding="utf-8"?>
<!--
  Wafer reskin (Phase 11) — glass surface treatment for the shade panel itself.
  Mirrors the wafer-glass library's surface recipe (HighlightPainter + BorderPainter)
  so the swipe-down shade reads as the same kind of glass plate as the notifications,
  the QS tiles, and every other surface in the reskin.

  Layered top to bottom:
    1. Top-edge highlight gradient (white ~25% → transparent over the first ~120dp)
       — fakes light catching the top of the panel.
    2. Hairline stroke (wafer_glass_border @ wafer_glass_border_width) framing the
       full panel.

  The actual backdrop blur + tint is handled by ScrimView's window-level RenderEffect
  (Phase 02) and the wafer_glass_tint_dark fill on `scrim_behind`. Together with this
  drawable the shade matches the library's full glass recipe (blur + tint + highlight
  + border) — there's just no drop shadow because the panel is full-window.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Top-edge highlight gradient. Pinned to the top of the panel with a fixed
         height so it doesn't stretch to fill tall screens. -->
    <item
        android:gravity="top|fill_horizontal"
        android:height="120dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Hairline border around the entire panel. -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="@*android:dimen/wafer_glass_border_width"
                android:color="@*android:color/wafer_glass_border" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</layer-list>
